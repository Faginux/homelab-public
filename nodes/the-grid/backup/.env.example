# Stack BACKUP — the-grid. Copy to .env and fill in.
#
# Compose project name: LOCK IT. Compose derives it from the name of the folder.
# So this stack would be called "backup" only while the folder has that
# name. If you set it here, the stack does not depend on where the file is.
COMPOSE_PROJECT_NAME=backup

# NOTIFICATION_URLS: NOT here any more (since 2026-09-23). It has the token of the
# bot, and dvb reads it from a file (NOTIFICATION_URLS_FILE, see docker-compose.yml).
#   /srv/docker/_secrets/backup/notification_urls   permissions 0400, NO newline.
# shoutrrr format, same channel as watchtower.
#   telegram://TOKEN@telegram?chats=CHAT_ID   (more URLs separated by a comma).
