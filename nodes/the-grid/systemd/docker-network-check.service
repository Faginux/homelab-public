[Unit]
Description=Send a Telegram alert if a running container has no network or no published ports
# Ordering only, no Requires=. If you stop Docker on purpose, this check
# must not start it again.
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Docker group and /srv/docker/_secrets/telegram. It does not need root.
User=ops
# Creates /var/lib/docker-network-check, owned by User=, and passes the path in
# $STATE_DIRECTORY. The script keeps the last notified state there.
StateDirectory=docker-network-check
ExecStart=/usr/local/bin/docker-network-check.sh
