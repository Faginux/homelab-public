# Stack PAPERLESS-NGX — the-grid. Copy to .env and fill in.

# Compose project name: LOCK IT. Same reason as always — see the other
# .env.example files of the-grid.
COMPOSE_PROJECT_NAME=paperless

# All the values below are for a NEW instance. They do not need to match
# the real ones of ARCADE. The import (document_importer) writes into the
# DB through SQL. It does not depend on the Postgres user/password or on the
# Django SECRET_KEY of the source. New values, generated here, are even better.
#
# [To check at the import] The export may include the Django users table
# (paperless-ngx does this since several versions). In that case,
# PAPERLESS_ADMIN_USER/PASSWORD below count only if the DB is still empty at the
# first start. The import can then overwrite the user with the one (and the
# hashed password) of the source. Do not assume. After the import, check if the
# admin login is the new one or the old one.

# --- SECRETS: NOT here any more (since 2026-09-23) ---
# Read from files, permissions 0400, WITHOUT a final newline (see docker-compose.yml,
# section secrets).
#   /srv/docker/_secrets/paperless/db_password  -> POSTGRES_PASSWORD_FILE (db)
#                                                  and PAPERLESS_DBPASS_FILE (app).
#   /srv/docker/_secrets/paperless/secret_key   -> PAPERLESS_SECRET_KEY_FILE.
# One file only for the DB password: the two copies cannot diverge.
# PAPERLESS_ADMIN_USER/PASSWORD/MAIL removed: they serve only to create the superuser
# on an empty DB, and the DB already exists.

# Since 2026-09-24 the compose file does NOT use env_file any more. Each PAPERLESS_*
# below reaches the container only if it is also listed in `environment:` of
# paperless-ngx in docker-compose.yml. A new variable = two lines, one here and
# one there. Only the db service reads POSTGRES_*.

# --- Postgres (used by db, and by paperless-ngx to connect — DUPLICATE
# the same real value in POSTGRES_USER and PAPERLESS_DBUSER, in POSTGRES_DB and in
# PAPERLESS_DBNAME) ---
POSTGRES_DB=changeme
POSTGRES_USER=changeme

# --- paperless-ngx: application config ---
PAPERLESS_TIME_ZONE=Europe/Rome
PAPERLESS_OCR_LANGUAGE=ita+eng
PAPERLESS_OCR_LANGUAGES=ita eng
PAPERLESS_URL=https://paperless.homelab.example
PAPERLESS_USE_X_FORWARD_HOST=true
PAPERLESS_PROXY_SSL_HEADER=["HTTP_X_FORWARDED_PROTO","https"]
PAPERLESS_TRUSTED_PROXIES=*
PAPERLESS_DBHOST=db
PAPERLESS_DBNAME=changeme
PAPERLESS_DBUSER=changeme
PAPERLESS_REDIS=redis://broker:6379
PAPERLESS_TIKA_ENABLED=1
PAPERLESS_TIKA_GOTENBERG_ENDPOINT=http://gotenberg:3000
PAPERLESS_TIKA_ENDPOINT=http://tika:9998
PAPERLESS_TASK_WORKERS=2
PAPERLESS_THREADS_PER_WORKER=2
PAPERLESS_FILENAME_FORMAT={{ document_type }}/{{ correspondent }}/{{ created_year }}/{{ created_month }}-{{ title }}
