# Stack BESZEL-AGENT — the-grid. Copy to .env and fill in.

# Compose project name: LOCK IT. Compose derives it from the name of the folder.
# If you move the file, Compose would "lose" the container that already runs.
# It would try to create the container again -> error "container name already in use".
COMPOSE_PROJECT_NAME=beszel-agent

# The three values below come from the UI of the Beszel hub (beszel.homelab.example),
# Add System -> name "the-grid". The hub generates KEY and TOKEN AS A PAIR for
# that specific system. Do not reuse the ones of ARCADE.

# Public key of the hub shown in "Add System". It is not a secret (it is a
# public key). It stays a config value specific to the system, with the
# same treatment, for consistency with the rest of the repo.
BESZEL_KEY=changeme

# URL of the hub for the outbound WebSocket connection. LAN IP of the scope,
# SAME value already used and working in the Windows agent of ARCADE.
BESZEL_HUB_URL=http://192.0.2.30:8090

# TOKEN: NOT here any more (since 2026-09-23). It is a real secret and the agent
# reads it from a file: /srv/docker/_secrets/beszel-agent/token, permissions 0400,
# no final newline (see docker-compose.yml, section secrets).
