# Copy to .env (gitignored) and generate the secrets on the-grid. NEVER by hand and never
# passed to Claude or committed:
#
#   cp .env.example .env
#   for v in KOMODO_DATABASE_PASSWORD KOMODO_INIT_ADMIN_PASSWORD KOMODO_JWT_SECRET KOMODO_WEBHOOK_SECRET; do
#     sed -i "s|^$v=.*|$v=$(openssl rand -hex 24)|" .env
#   done
#
# -hex and not -base64: the DB password ends in a mongodb:// URI, where
# "/", "+" and "=" would need encoding. Hexadecimal = no doubt.
# The admin password serves only for the first login (user "ops"). You read it
# from the .env on the-grid (if the UI allows you to change it, to check at the first
# login, change it there).

COMPOSE_PROJECT_NAME=komodo
KOMODO_DATABASE_USERNAME=komodo
KOMODO_DATABASE_PASSWORD=changeme
KOMODO_INIT_ADMIN_PASSWORD=changeme
KOMODO_JWT_SECRET=changeme
KOMODO_WEBHOOK_SECRET=changeme
