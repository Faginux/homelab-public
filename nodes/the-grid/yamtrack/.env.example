COMPOSE_PROJECT_NAME=yamtrack

# SECRET and STEAM_API_KEY: NOT here any more (since 2026-09-23). Yamtrack reads them
# from files, permissions 0400 of ops (UID 1000), no final newline,
# names WITHOUT an extension (see docker-compose.yml, section secrets):
#   /srv/docker/_secrets/yamtrack/secret
#   /srv/docker/_secrets/yamtrack/steam_api_key
