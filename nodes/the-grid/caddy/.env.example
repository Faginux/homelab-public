# Stack CADDY + CROWDSEC — the-grid. Copy to .env and fill in.

# Compose project name: LOCK IT. Same reason as always — see the other
# .env.example files of the-grid.
COMPOSE_PROJECT_NAME=caddy

# Cloudflare token (DNS edit scope on the homelab.example zone) — it serves the DNS-01
# for the wildcard certificate *.homelab.example AND the dynamic_dns. YOU write it
# directly here on the-grid: never pass it in chat, never let a command print it.
# You can use the same value as the Caddy on ARCADE (same token, same
# zone). You can also generate a new one with the same scope. The choice is
# yours. It is not necessary to rotate it.
CLOUDFLARE_API_TOKEN=changeme

# Key of the CrowdSec bouncer — it does NOT exist until the crowdsec container
# runs at least one time. Sequence:
#   1. docker compose up -d crowdsec        (only crowdsec, not caddy)
#   2. docker exec crowdsec cscli bouncers add caddy-bouncer
#      -> prints the key ONE TIME ONLY, copy it at once
#   3. Write it below
#   4. docker compose up -d                 (now also caddy, with the key ready)
CROWDSEC_API_KEY=changeme
