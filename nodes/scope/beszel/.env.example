# Stack BESZEL (hub) + beszel-agent — scope. Copy to .env and fill in.

# Compose project name: LOCK IT. Same reason as always — see the other
# .env.example files of the repo. Today the basename of the folder is already "beszel".
# But an explicit value stays safe against future moves.
COMPOSE_PROJECT_NAME=beszel

# Public key of the hub shown in "Add System" for the system "scope".
# It is not a secret (it is a public key), but it stays a config value
# specific to the system. We use the same treatment for consistency with the rest of the
# repo (see nodes/the-grid/beszel-agent/.env.example).
BESZEL_KEY=changeme

# URL of the hub for the outbound WebSocket connection. In the live config it is
# the LAN IP of the scope (192.0.2.30:8090), although hub and agent run on the
# same host. We kept it as it is, not "corrected" to localhost. If it
# works today, a change here is a change nobody asked for.
BESZEL_HUB_URL=http://192.0.2.30:8090

# REAL SECRET — it authenticates the agent on the hub. Copy the real value from
# /home/ops/beszel/docker-compose.yml on the Pi. Open it with an editor,
# not with a command that prints it in a shared or logged terminal.
# This is the same reason why you must rotate this specific TOKEN anyway (see
# PROBLEMI-E-SOLUZIONI.md: it ended in plain text in this session).
BESZEL_TOKEN=changeme
