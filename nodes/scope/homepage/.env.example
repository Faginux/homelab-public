# Copy this file to .env on the scope and write the real values there.
# .env is ignored by git. Do not write real values in this file.

# Project name. It is the name of the directory, written here so that it
# does not change if the directory moves (Trap 2 of CLAUDE.md).
COMPOSE_PROJECT_NAME=homepage

# Komodo API key with READ-ONLY permissions (Komodo > Settings > API keys).
# Do not use a key that can deploy.
HOMEPAGE_VAR_KOMODO_KEY=changeme
HOMEPAGE_VAR_KOMODO_SECRET=changeme

# Seerr API key (Seerr > Settings > General > API Key). Seerr has ONE key
# and it has admin rights: there is no read-only key. The widget only sends
# GET /api/v1/request/count.
HOMEPAGE_VAR_SEERR_KEY=changeme

# Tdarr API key (Tdarr > Tools > API Keys). Make a NEW key only for Homepage:
# then you can revoke it alone. Tdarr has no read-only key, so it has full
# rights. The widget only sends POST /api/v2/cruddb with the header x-api-key
# to read the statistics.
HOMEPAGE_VAR_TDARR_KEY=changeme
