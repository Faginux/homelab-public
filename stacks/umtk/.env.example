# Stack UMTK (TSSK) - ARCADE. Copy to .env.

# Compose project name: LOCK IT (CLAUDE.md, Trappola 2).
COMPOSE_PROJECT_NAME=umtk

# UMTK config (config.yml with the Sonarr API key, tssk_config.yml, logs/)
# - outside the repo, absolute path, convention S:/docker-appdata/<stack>.
UMTK_CONFIG=S:/docker-appdata/umtk/config

# Where TSSK writes the YAML files of the overlays: in the Kometa config, which
# reads them as config/tssk/*.yml (Kometa mounts only its config folder).
UMTK_OUTPUT=S:/docker-appdata/kometa/config/tssk

# The Sonarr API key does NOT go here: it is in config.yml in UMTK_CONFIG.
