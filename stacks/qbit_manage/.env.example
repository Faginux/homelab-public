# Stack qbit_manage - ARCADE. Copy to .env.

# Compose project name: LOCK IT (CLAUDE.md, Trappola 2).
COMPOSE_PROJECT_NAME=qbit_manage

# qbit_manage config (config.yml with host/user/pass of qBittorrent, logs/,
# .backups/). Outside the repo, absolute path, convention S:/docker-appdata/<stack>.
# Template without secrets: config.yml.example in this folder.
QBIT_CONFIG=S:/docker-appdata/qbit_manage/config

# Credentials of the qBittorrent Web UI: since 2026-10-14 they are ONLY in
# config.yml (user/pass in plain text, path A of Phase 1), not here.
