# =============================================================================
#  dvb-local  --  local archive on S:\Bakcup_Servarr+\Docker Volumes
#  Copy to backup-local.env. No quotes: docker compose passes the full
#  line after the equal sign.
# =============================================================================

########### SCHEDULE
# minute hour day-of-month month day-of-week   (1=Monday, 4=Thursday)
BACKUP_CRON_EXPRESSION=15 2 * * 1,4
# without TZ the container runs in UTC and in summer it would start at 05:00
TZ=Europe/Rome

########### NAMING AND COMPRESSION
BACKUP_FILENAME=arcade-volumes-%Y-%m-%dT%H-%M-%S.{{ .Extension }}
BACKUP_COMPRESSION=gz
# 0 = use all the available threads (Ryzen 9 5900X)
GZIP_PARALLELISM=0

########### LOCAL TARGET
BACKUP_ARCHIVE=/archive

########### ROTATION
# 29, not 28: with 28 the pruning deletes the oldest backup on the same day that
# the tool makes a new one. With 29 you always have 8 archives, never 7.
BACKUP_RETENTION_DAYS=29
# CRITICAL: without a prefix, the pruning deletes ALL old files
# in /archive, not only ours.
BACKUP_PRUNING_PREFIX=arcade-volumes-
# margin against a race condition between the end of the backup and the rotation
BACKUP_PRUNING_LEEWAY=10m

########### EXCLUSIONS
# Since 2026-10-02 BACKUP_EXCLUDE_REGEXP is in docker-compose.yml (anchor
# x-backup-exclude, shared by the three services): it is not a secret, so it is
# better in git. If you put it here, it has no effect (environment: wins over env_file).

########### STOP CONTAINERS DURING THE BACKUP
# stops the containers with the label docker-volume-backup.stop-during-backup=true
BACKUP_STOP_DURING_BACKUP_LABEL=true

########### TELEGRAM NOTIFICATIONS
# format: telegram://BOT_TOKEN@telegram?chats=CHAT_ID
# REAL SECRET - never commit the real value, also not here. Only in
# backup-local.env (in .gitignore).
NOTIFICATION_URLS=changeme
# error = notify only the failures (since 2026-10-12. Before, info = also the successes, 2 each
# week with no action necessary). The weekly heartbeat is dvb-remote-the-grid, still at info.
NOTIFICATION_LEVEL=error
