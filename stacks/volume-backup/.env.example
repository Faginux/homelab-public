# Stack VOLUME-BACKUP - dvb-local + dvb-remote-the-grid. Copy to .env.

# Compose project name: LOCK IT. Compose takes it from the folder name.
# If somebody renames the folder in the future, the existing containers
# cannot be reached without this line. Then you get "container name already in use"
# at the first docker compose up.
# Checked with: docker compose ls -> real project = volume-backup
COMPOSE_PROJECT_NAME=volume-backup
