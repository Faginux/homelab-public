# ════════════════════════════════════════════════════════════
#  Stack IMMICH - copy to .env and fill in. git IGNORES the .env.
#  Adapted from: S:\Bakcup_Servarr+\Docker yml\immich\.env
# ════════════════════════════════════════════════════════════

# Compose project name. Here it is not necessary: the compose sets
# "name: immich" at the top of the file, and that wins over this
# variable. We keep it for consistency with the other stacks of
# the repo, and as a safety net if somebody removes "name:".
COMPOSE_PROJECT_NAME=immich

# Immich image version: since 2026-10-26 it is NOT here. It is in the
# `image:` lines of docker-compose.yml (server + machine-learning), so the
# release-check job reads it. Update it by hand after you read the release
# notes: Immich broke the vector database compatibility between majors.

# ── WHERE THE DATA IS ───────────────────────────────────────
# Photo library. It is ALREADY an absolute path (its own disk B),
# not relative to the compose: check with docker inspect immich-server
# before you change it. Use FORWARD SLASHES, also on Windows.
IMMICH_LIBRARY=B:/immich-library

# ── Database (PostgreSQL) ───────────────────────────────────
# DB_HOSTNAME is the container_name of the service "database" in the
# compose (immich-postgres): it must be equal. It is not a secret.
DB_HOSTNAME=immich-postgres
DB_USERNAME=changeme
# DB_PASSWORD is not here any more (Phase 1, 2026-10-14): file
# S:/docker-appdata/_secrets/immich/db_password, with no final newline,
# written by the operator. DB_PASSWORD_FILE and POSTGRES_PASSWORD_FILE read it.
DB_DATABASE_NAME=changeme

# ── Redis ────────────────────────────────────────────────────
# REDIS_HOSTNAME is the container_name of the service "redis"
# (immich-redis): it must be equal. It is not a secret.
REDIS_HOSTNAME=immich-redis

# ── Machine Learning ─────────────────────────────────────────
# Internal URL of the ML container, from its container_name and its
# default port (3003). It is not a secret. Do not change it, unless you
# change the container_name of the service immich-machine-learning.
IMMICH_MACHINE_LEARNING_URL=http://immich-machine-learning:3003

# Time zone of the server + ML containers (env_file). It makes the schedule of
# the database dump set in the UI (Administration -> Settings -> Backup) use
# Rome time, with DST. Without TZ the container is in UTC (checked on
# 2026-09-27: a dump set at 01:45 started at 03:45 local time).
TZ=Europe/Rome
