# Docker Compose project name. A new stack (no earlier stack had this name).
# We set it for consistency with the convention of the repo (refer to
# CLAUDE.md, Trappola 2), and so it stays correct if the folder moves.
COMPOSE_PROJECT_NAME=tdarr

# UID/GID of the processes in the containers. The Tdarr image does the
# necessary chown at the start (PIANO-TDARR.md §4.5). Use the same value in
# BOTH containers (server and node). If not, one container can write files
# that the other cannot read or delete.
PUID=1000
PGID=1000

# Tdarr application data folder (server config, job database, logs). Outside
# the repo, absolute path. It is NOT a video library: only the Tdarr state.
# Made on 2026-09-03 in S:/docker-appdata/tdarr. There was no earlier
# convention for new stacks (S:/docker exists, but it is the internal
# storage of Docker Desktop/WSL2: do not touch it).
TDARR_SERVER_DATA=S:/docker-appdata/tdarr

# TDARR_API_KEY is not here any more (Phase 1, 2026-10-14). The key is in the
# JSON files of configs/ (Tdarr_Server_Config.json -> seededApiKey,
# Tdarr_Node_Config.json -> apiKey). They are in the encrypted backup of
# S:/docker-appdata.
# It must start with "tapi_", minimum 14 characters in total.
