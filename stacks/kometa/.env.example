# Stack KOMETA - ARCADE. Copy to .env.

# Compose project name: LOCK IT (CLAUDE.md, Trappola 2).
COMPOSE_PROJECT_NAME=kometa

# Kometa config folder (config.yml, cache, logs, assets) - outside the repo,
# absolute path, the same convention as tdarr (S:/docker-appdata/<stack>).
KOMETA_CONFIG=S:/docker-appdata/kometa/config

# The Plex token and the TMDb API key do NOT go here. They are in config.yml in
# KOMETA_CONFIG, so they do not go into the environment of the container.
